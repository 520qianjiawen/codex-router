#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"
mode=$(node src/config-manager.mjs status | node -e 'let s=""; process.stdin.on("data",d=>s+=d); process.stdin.on("end",()=>process.stdout.write(JSON.parse(s).mode))')
signed=$(node src/config-manager.mjs status | node -e 'let s=""; process.stdin.on("data",d=>s+=d); process.stdin.on("end",()=>process.stdout.write(JSON.parse(s).signed_routing ? "true" : "false"))')
restore=false
if [ "$mode" = "router" ]; then
  node src/config-manager.mjs disable >/dev/null
  restore=true
fi
restore_config() {
  if [ "$restore" = true ]; then
    node src/config-manager.mjs enable >/dev/null
    if [ "$signed" = true ]; then
      node src/config-manager.mjs signed-enable >/dev/null
      node src/catalog.mjs >/dev/null
    fi
  fi
}
restore_after_failure() {
  restore_config >/dev/null 2>&1 || true
}
trap restore_after_failure EXIT HUP INT TERM
node src/catalog.mjs --refresh-native --bundled-native
restore_config
restore=false
trap - EXIT HUP INT TERM
echo "Native and external model catalogs refreshed. Fully quit and reopen Codex."
