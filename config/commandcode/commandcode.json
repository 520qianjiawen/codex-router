{
  "version": 1,
  "providers": [
    {
      "id": "commandcode",
      "displayName": "Command Code API",
      "kind": "openai-compatible",
      "ownedBy": "commandcode",
      "baseUrl": "https://api.commandcode.ai/provider/v1",
      "baseUrlEnv": "COMMANDCODE_BASE_URL",
      "credential": {
        "environment": [
          "COMMAND_CODE_API_KEY",
          "COMMANDCODE_API_KEY"
        ],
        "file": "commandcode-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-commandcode"
        ],
        "prompt": "Command Code API key"
      }
    },
    {
      "id": "commandcode-messages",
      "displayName": "Command Code API Messages",
      "kind": "openai-compatible",
      "ownedBy": "commandcode",
      "variantOf": "commandcode",
      "protocol": "anthropic",
      "baseUrl": "https://api.commandcode.ai/provider/v1",
      "baseUrlEnv": "COMMANDCODE_BASE_URL",
      "credential": {
        "environment": [
          "COMMAND_CODE_API_KEY",
          "COMMANDCODE_API_KEY"
        ],
        "file": "commandcode-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-commandcode"
        ],
        "prompt": "Command Code API key"
      }
    },
    {
      "id": "commandcode-oauth",
      "displayName": "Command Code OAuth",
      "kind": "openai-compatible",
      "ownedBy": "commandcode",
      "authVariantOf": "commandcode",
      "baseUrl": "https://api.commandcode.ai/provider/v1",
      "baseUrlEnv": "COMMANDCODE_BASE_URL",
      "credential": {
        "cliSession": {
          "directory": ".commandcode",
          "file": "auth.json",
          "field": "apiKey",
          "homeEnv": "COMMANDCODE_CLI_HOME",
          "label": "Command Code CLI sign-in",
          "loginCommand": "command-code login"
        }
      }
    },
    {
      "id": "commandcode-oauth-messages",
      "displayName": "Command Code OAuth Messages",
      "kind": "openai-compatible",
      "ownedBy": "commandcode",
      "variantOf": "commandcode-oauth",
      "authVariantOf": "commandcode-messages",
      "protocol": "anthropic",
      "baseUrl": "https://api.commandcode.ai/provider/v1",
      "baseUrlEnv": "COMMANDCODE_BASE_URL",
      "credential": {
        "cliSession": {
          "directory": ".commandcode",
          "file": "auth.json",
          "field": "apiKey",
          "homeEnv": "COMMANDCODE_CLI_HOME",
          "label": "Command Code CLI sign-in",
          "loginCommand": "command-code login"
        }
      }
    }
  ]
}
