{
  "version": 1,
  "providers": [
    {
      "id": "kimi-oauth",
      "displayName": "Kimi Code OAuth",
      "kind": "oauth",
      "ownedBy": "kimi",
      "proxyBaseEnv": "KIMI_OAUTH_FORWARD_BASE_URL"
    },
    {
      "id": "kimi-api",
      "displayName": "Kimi Platform API",
      "kind": "openai-compatible",
      "ownedBy": "kimi",
      "baseUrl": "https://api.moonshot.ai/v1",
      "baseUrlEnv": "KIMI_API_BASE_URL",
      "credential": {
        "environment": [
          "KIMI_API_KEY",
          "MOONSHOT_API_KEY"
        ],
        "file": "kimi-api-key.secret",
        "legacyFiles": [
          "api-key.secret"
        ],
        "keychainServices": [
          "codex-router-kimi-api",
          "kimi-codex-api"
        ],
        "prompt": "Kimi Platform API key"
      }
    }
  ]
}
